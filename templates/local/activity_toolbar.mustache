{{!
    @template format_streamdeck/local/activity_toolbar

    Top bar shown on activity pages in a Streamdeck course.

    Context variables required for this template:
    * courseurl - string - Course page
    * sectionurl - string - Episode page of the activity's section, if any
    * sectionname - string - Name of that section
    * colourmode - object - Context for format_streamdeck/colour_mode_menu (the view menu)

    Example context (json):
    {
        "courseurl": "https://example.com/course/view.php?id=2",
        "sectionurl": "https://example.com/course/view.php?id=2&section=3",
        "sectionname": "Week 3",
        "colourmode": {"currentmode": "dark", "options": []}
    }
}}
<nav class="streamdeck-activity-toolbar" aria-label="{{#str}}activitytoolbar, format_streamdeck{{/str}}">
    <div class="streamdeck-activity-toolbar-links">
        <a href="{{courseurl}}" class="sd-btn sd-btn--ghost">
            <i class="fa-solid fa-house" aria-hidden="true"></i>
            {{#str}}backtocourse, format_streamdeck{{/str}}
        </a>
        {{#sectionurl}}
            <a href="{{sectionurl}}" class="sd-btn sd-btn--ghost">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                {{#str}}backtoepisode, format_streamdeck, {{sectionname}}{{/str}}
            </a>
        {{/sectionurl}}
    </div>
    {{#colourmode}}{{> format_streamdeck/colour_mode_menu}}{{/colourmode}}
</nav>
