{{!
    @template format_streamdeck/local/discussion_post

    A reply in an episode's discussion, with the replies to it nested beneath.

    Context variables required for this template: see format_streamdeck/local/discussion_post_body, plus
    * children - array - Replies to this post
    * haschildren - bool - Whether there are any

    Example context (json):
    {
        "id": 2, "author": "Tia Teacher", "avatar": "", "time": "1 hour ago", "datetime": "",
        "message": "<p>A noun names a person, place or thing.</p>", "depth": 1, "children": [], "haschildren": false
    }
}}
<li class="sd-reply" data-depth="{{depth}}">
    <article class="sd-post" data-region="sd-post" data-postid="{{id}}" id="sd-post-{{id}}">
        {{> format_streamdeck/local/discussion_post_body}}
    </article>
    {{#haschildren}}
        <ol class="sd-replies sd-replies--nested">
            {{#children}}
                {{> format_streamdeck/local/discussion_post}}
            {{/children}}
        </ol>
    {{/haschildren}}
</li>
