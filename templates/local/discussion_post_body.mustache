{{!
    @template format_streamdeck/local/discussion_post_body

    The content of a post in an episode's discussion: author, message, attachments and actions.

    Context variables required for this template:
    * id - int - Post id
    * author - string - Author's name
    * avatar - string - Author's picture
    * isown - bool - Whether the learner wrote it
    * time - string - "2 hours ago"
    * datetime - string - Full date and time
    * message - string - Formatted message (HTML)
    * attachments - array - name, url
    * hasattachments - bool
    * isprivate - bool - Private reply
    * canreply, canedit, candelete - bool
    * replyurl, editurl, deleteurl - string - mod_forum post.php forms
    * hasactions - bool

    Example context (json):
    {
        "id": 1, "author": "Sam Student", "avatar": "", "isown": true, "time": "2 hours ago",
        "datetime": "Saturday, 31 October 2026, 9:00 PM", "message": "<p>Can someone explain nouns?</p>",
        "attachments": [], "hasattachments": false, "isprivate": false,
        "canreply": true, "replyurl": "#", "canedit": true, "editurl": "#", "candelete": false, "deleteurl": "",
        "hasactions": true
    }
}}
<div class="sd-post-avatar">
    {{#avatar}}<img class="sd-avatar" src="{{avatar}}" alt="">{{/avatar}}
</div>
<div class="sd-post-main">
    <header class="sd-post-header">
        <span class="sd-post-author">{{author}}</span>
        {{#isown}}<span class="sd-post-tag">{{#str}}you, format_streamdeck{{/str}}</span>{{/isown}}
        {{#isprivate}}
            <span class="sd-post-tag sd-post-tag--private">
                <i class="fa-solid fa-lock" aria-hidden="true"></i> {{#str}}privatereply, forum{{/str}}
            </span>
        {{/isprivate}}
        <time class="sd-post-time" title="{{datetime}}">{{time}}</time>
    </header>
    <div class="sd-post-message">{{{message}}}</div>
    {{#hasattachments}}
        <ul class="sd-post-attachments" aria-label="{{#str}}attachments, forum{{/str}}">
            {{#attachments}}
                <li>
                    <a href="{{url}}" class="sd-attachment">
                        <i class="fa-solid fa-paperclip" aria-hidden="true"></i> {{name}}
                    </a>
                </li>
            {{/attachments}}
        </ul>
    {{/hasattachments}}
    {{#hasactions}}
        <div class="sd-post-actions">
            {{#canreply}}
                <button type="button" class="sd-post-action" data-action="sd-compose" data-url="{{replyurl}}">
                    <i class="fa-solid fa-reply" aria-hidden="true"></i> {{#str}}reply, forum{{/str}}
                </button>
            {{/canreply}}
            {{#canedit}}
                <button type="button" class="sd-post-action" data-action="sd-compose" data-url="{{editurl}}">
                    <i class="fa-solid fa-pen" aria-hidden="true"></i> {{#str}}edit{{/str}}
                </button>
            {{/canedit}}
            {{#candelete}}
                <button type="button" class="sd-post-action" data-action="sd-compose" data-url="{{deleteurl}}">
                    <i class="fa-solid fa-trash" aria-hidden="true"></i> {{#str}}delete{{/str}}
                </button>
            {{/candelete}}
        </div>
    {{/hasactions}}
    <div data-region="sd-composer-slot" data-postid="{{id}}"></div>
</div>
