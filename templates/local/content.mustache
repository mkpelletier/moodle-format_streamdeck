{{!
    @template format_streamdeck/local/content

    Main content template for the Streamdeck course format.

    Context variables required for this template:
    * showhero - bool - Whether to show the hero section
    * issectionview - bool - Whether viewing a specific section

    Example context (json):
    { "showhero": true, "issectionview": false }
}}

<div class="format-streamdeck">

    {{#herofontgoogle}}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{{herofonturlparam}}}&display=swap">
    {{/herofontgoogle}}

    {{#showhero}}
    <!-- HERO WITH PAGE HEADER OVERLAY -->
    <section class="hero {{#hascourseimage}}has-image{{/hascourseimage}}"
        {{#hascourseimage}}style="background-image: url('{{{courseimage}}}');"{{/hascourseimage}}>

        <!-- Dark overlay -->
        <div class="hero-overlay"></div>

        <!-- Main hero content -->
        <div class="hero-content">
            <div class="container-fluid px-4 px-md-5">
                <div class="row">
                    <div class="col-lg-7 col-xl-6">

                        <!-- Text box with dark scrim + blur -->
                        <div class="streamdeck-hero-scrim">
                            <h1 class="streamdeck-hero-title display-3 fw-bold mb-3"
                                {{#herofontcss}}style="--sd-hero-font: {{{herofontcss}}};"{{/herofontcss}}>
                                {{{fullname}}}
                            </h1>

                            <!-- Metadata -->
                            <div class="d-flex flex-wrap align-items-center gap-4 mb-4 text-white fs-5">
                                <span>{{year}}</span>
                                <span>•</span>
                                <span>{{shortname}}</span>
                                <span>•</span>
                                <span>{{duration}}</span>

                                {{#hasinstructor}}
                                    {{^multipleinstructors}}
                                        <div class="hero-instructor d-inline-flex align-items-center gap-3">
                                            <a href="{{instructorprofileurl}}" class="hero-instructor-link d-inline-flex align-items-center gap-3 text-decoration-none">
                                                <div class="hero-instructor-avatar-wrapper">
                                                    {{{instructoravatarhtml}}}
                                                </div>
                                                <div class="hero-instructor-meta d-flex flex-column">
                                                    {{#instructorrolelabel}}
                                                        <span class="hero-instructor-label text-uppercase small text-white-50">
                                                            {{{instructorrolelabel}}}
                                                        </span>
                                                    {{/instructorrolelabel}}
                                                    <span class="hero-instructor-name fw-semibold text-white">{{instructor}}</span>
                                                </div>
                                            </a>
                                        </div>
                                    {{/multipleinstructors}}

                                    {{#multipleinstructors}}
                                        <div class="hero-instructor-multi d-inline-flex align-items-center gap-2 flex-wrap">
                                            {{#instructorgrouplabel}}
                                                <span class="hero-instructor-label text-uppercase small text-white-50 me-1">
                                                    {{{instructorgrouplabel}}}
                                                </span>
                                            {{/instructorgrouplabel}}
                                            <div class="hero-instructor-strip-inline d-inline-flex align-items-center gap-2 flex-wrap">
                                                {{#instructorteam}}
                                                    <a href="{{contacturl}}" class="hero-instructor-chip-inline text-decoration-none">
                                                        <div class="hero-instructor-chip-avatar-inline">
                                                            {{{avatarhtml}}}
                                                        </div>

                                                        <div class="hero-instructor-popout">
                                                            <div class="hero-instructor-popout-inner">
                                                                <div class="hero-instructor-popout-avatar">
                                                                    {{{avatarhtml}}}
                                                                </div>
                                                                <div class="hero-instructor-popout-meta">
                                                                    <div class="hero-instructor-popout-name">
                                                                        {{name}}
                                                                    </div>
                                                                    {{#rolelabel}}
                                                                        <div class="hero-instructor-popout-role">
                                                                            {{rolelabel}}
                                                                        </div>
                                                                    {{/rolelabel}}
                                                                    <div class="hero-instructor-popout-cta">
                                                                        {{#str}}message, message{{/str}}
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                    </a>
                                                {{/instructorteam}}
                                            </div>
                                        </div>
                                    {{/multipleinstructors}}
                                {{/hasinstructor}}
                            </div>

                            {{#summary}}
                                <p class="streamdeck-hero-summary lead mb-5">
                                    {{{summary}}}
                                </p>
                            {{/summary}}

                            <!-- Buttons + completion -->
                            <div class="d-flex align-items-center gap-4 flex-wrap">
                                <a href="{{playurl}}" class="sd-btn sd-btn--primary sd-btn--lg">
                                    <i class="fa-solid fa-play" aria-hidden="true"></i>
                                    {{playlabel}}
                                </a>
                                <button type="button" class="sd-btn sd-btn--glass sd-btn--lg streamdeck-more-info-btn">
                                    {{#str}}moreinfo, format_streamdeck{{/str}}
                                </button>
                                {{! ── Announcements icon (bullhorn) ──}}
                                {{#hasannouncementicon}}
                                    <button type="button"
                                            class="streamdeck-hero-icon-btn streamdeck-hero-announcements-btn
                                                   {{#announcementunreadcount}}has-unread{{/announcementunreadcount}}"
                                            data-announcements-contextid="{{announcementcontextid}}"
                                            data-announcements-forumid="{{announcementforumid}}"
                                            aria-label="{{#str}} announcements, format_streamdeck {{/str}}"
                                            title="{{#str}} announcements, format_streamdeck {{/str}}">
                                        <i class="fa fa-bullhorn" aria-hidden="true"></i>
                                        {{#announcementunreadcount}}
                                            <span class="streamdeck-hero-icon-badge">{{announcementunreadcount}}</span>
                                        {{/announcementunreadcount}}
                                    </button>
                                {{/hasannouncementicon}}

                                {{! ── General forum icon (comments) ──}}
                                {{#hasgeneralforumicon}}
                                    <button type="button"
                                            class="streamdeck-hero-icon-btn streamdeck-hero-generalforum-btn"
                                            data-generalforum-contextid="{{generalforumcontextid}}"
                                            aria-label="{{#str}} generalforum, format_streamdeck {{/str}}"
                                            title="{{#str}} generalforum, format_streamdeck {{/str}}">
                                        <i class="fa fa-comments" aria-hidden="true"></i>
                                    </button>
                                {{/hasgeneralforumicon}}

                                {{! ── Participants icon (capability-gated) ──}}
                                {{#hasparticipantsicon}}
                                    <button type="button"
                                            class="streamdeck-hero-icon-btn streamdeck-hero-participants-btn"
                                            data-participants-url="{{participantsurl}}"
                                            aria-label="{{#str}} participants, format_streamdeck {{/str}}"
                                            title="{{#str}} participants, format_streamdeck {{/str}}">
                                        <i class="fa fa-users" aria-hidden="true"></i>
                                    </button>
                                {{/hasparticipantsicon}}

                                {{! ── Live class icon (BigBlueButton) ──}}
                                {{#hasliveclassicon}}
                                    <button type="button"
                                            class="streamdeck-hero-icon-btn streamdeck-hero-liveclass-btn"
                                            data-liveclass-url="{{liveclassurl}}"
                                            aria-label="{{#str}} liveclass, format_streamdeck {{/str}}"
                                            title="{{#str}} liveclass, format_streamdeck {{/str}}">
                                        <i class="fa-solid fa-chalkboard-user" aria-hidden="true"></i>
                                    </button>
                                {{/hasliveclassicon}}
                                    {{#colourmode}}{{> format_streamdeck/colour_mode_menu}}{{/colourmode}}

                                {{#hascompletion}}
                                <button
                                    type="button"
                                    class="streamdeck-hero-grades-btn btn btn-link p-0 text-decoration-none"
                                    data-grades-url="{{gradesurl}}"
                                    aria-label="{{#str}}viewgrades, format_streamdeck{{/str}}"
                                    title="{{#str}}viewgradescta, format_streamdeck{{/str}}">
                                    <span class="completion-badge d-flex align-items-center gap-3">
                                        <span class="badge-circle" style="--sd-progress: {{completionpercent}}%;">
                                            <span class="badge-text">{{completionpercent}}%</span>
                                        </span>
                                        <span class="completion-badge-text small">{{completiontext}}</span>
                                    </span>
                                </button>
                                {{/hascompletion}}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    {{/showhero}}

{{! SECTION VIEW: EPISODE + RELATED }} 
{{#issectionview}}
<section class="streamdeck-episode-page {{#hasleftcolumn}}has-related-resources{{/hasleftcolumn}} {{#noepisode}}no-episode{{/noepisode}}">
    <div class="episode-container">
        <article class="streamdeck-episode-card">
            <div class="streamdeck-episode-header-wrapper">
                <h1 class="streamdeck-episode-title">{{#episode}}{{name}}{{/episode}}{{^episode}}{{currentsectionname}}{{/episode}}</h1>
                <div class="streamdeck-episode-header-actions">
                    <a href="{{courseurl}}" class="sd-btn sd-btn--ghost">
                        <i class="fa-solid fa-house" aria-hidden="true"></i>
                        {{#str}}backtocourse, format_streamdeck{{/str}}
                    </a>
                        {{#colourmode}}{{> format_streamdeck/colour_mode_menu}}{{/colourmode}}
                </div>
            </div>

            <header class="streamdeck-episode-header">
                <div class="streamdeck-episode-tagline">
                    {{#episodenumber}}
                    <span class="streamdeck-episode-pill">
                        {{#str}}episode, format_streamdeck{{/str}} {{episodenumber}}
                    </span>
                    {{/episodenumber}}
                    {{#episodeseasonname}}
                    <span class="streamdeck-episode-sectionname">{{episodeseasonname}}</span>
                    {{/episodeseasonname}}
                    {{#episode}}{{#currentsectionname}}
                    <span class="streamdeck-episode-sectionname">{{currentsectionname}}</span>
                    {{/currentsectionname}}{{/episode}}
                    {{#episodedurationtext}}
                    <span class="streamdeck-episode-sectionname">
                        <i class="fa-regular fa-clock" aria-hidden="true"></i> {{episodedurationtext}}
                    </span>
                    {{/episodedurationtext}}
                </div>
            </header>

            {{#episode}}
                {{#isstage}}
                    {{> format_streamdeck/local/activity_stage}}
                {{/isstage}}
                {{^isstage}}
                    {{#h5phtml}}{{{h5phtml}}}{{/h5phtml}}
                    {{^h5phtml}}
                    <div class="streamdeck-episode-video">
                        <div class="streamdeck-episode-video-inner">
                            <iframe src="{{embedurl}}"
                                    class="streamdeck-episode-video-iframe"
                                    title="{{name}}"
                                    allowfullscreen></iframe>
                        </div>
                    </div>
                    {{/h5phtml}}
                {{/isstage}}

                {{#introhtml}}
                <div class="streamdeck-episode-intro">{{{introhtml}}}</div>
                {{/introhtml}}

                {{^isstage}}
                <div class="streamdeck-episode-actions">
                    <a href="{{url}}" class="sd-btn sd-btn--primary">
                        <i class="fa-solid fa-up-right-from-square" aria-hidden="true"></i>
                        {{#iscomplete}}{{#str}}replay, format_streamdeck{{/str}}{{/iscomplete}}
                        {{^iscomplete}}{{#str}}play, format_streamdeck{{/str}}{{/iscomplete}}
                    </a>

                    {{#completionenabled}}
                    <span class="streamdeck-episode-status {{#iscomplete}}is-complete{{/iscomplete}}">
                        {{#iscomplete}}{{#str}}completed, format_streamdeck{{/str}}{{/iscomplete}}
                        {{^iscomplete}}{{#str}}todo, format_streamdeck{{/str}}{{/iscomplete}}
                    </span>
                    {{/completionenabled}}
                </div>
                {{/isstage}}
            {{/episode}}

            {{#noepisode}}
            <div class="streamdeck-episode-empty">
                <p>{{#str}}episodeempty, format_streamdeck{{/str}}</p>
            </div>
            {{/noepisode}}

            {{! Navigation footer: always present so every unit can be left in both directions. }}
            <nav class="streamdeck-episode-nav" aria-label="{{#str}}episodenavigation, format_streamdeck{{/str}}">
                {{#hasprevsection}}
                <a href="{{prevsectionurl}}" class="sd-btn sd-btn--ghost">
                    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                    {{#str}}previousepisode, format_streamdeck{{/str}}
                    <span class="visually-hidden">: {{prevsectionname}}</span>
                </a>
                {{/hasprevsection}}

                <div class="streamdeck-episode-nav-spacer"></div>

                {{#hasnextsection}}
                    {{#canshownextbutton}}
                    <a href="{{nextsectionurl}}" class="sd-btn sd-btn--primary">
                        {{#str}}nextepisode, format_streamdeck{{/str}}
                        <span class="visually-hidden">: {{nextsectionname}}</span>
                        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                    </a>
                    {{/canshownextbutton}}
                    {{^canshownextbutton}}
                    <span class="streamdeck-episode-nav-hint">{{#str}}nextepisodelocked, format_streamdeck{{/str}}</span>
                    {{/canshownextbutton}}
                {{/hasnextsection}}
            </nav>
        </article>

        {{#hasleftcolumn}}
        <aside class="streamdeck-related-block" aria-label="{{#str}}episodesidebar, format_streamdeck{{/str}}">
            {{#hasrelatedsidebar}}
            <div class="related-sidebar">
                {{#hasrelatedresources}}
                <section class="related-resources">
                    <h2>{{#str}}relatedresources, format_streamdeck{{/str}}</h2>

                    <ul class="streamdeck-related-episodes">
                        {{#relatedresources}}
                        <li class="streamdeck-related-episode">
                            <a href="{{url}}" class="streamdeck-related-episode-link" target="_blank" rel="noopener">
                                {{#icon}}
                                <img src="{{icon}}" alt="" class="streamdeck-related-episode-icon" />
                                {{/icon}}
                                <div class="streamdeck-related-episode-main">
                                    <span class="streamdeck-related-episode-title">{{label}}</span>
                                </div>
                            </a>
                        </li>
                        {{/relatedresources}}
                    </ul>
                </section>
                {{/hasrelatedresources}}

                {{#relatedactivities.0}}
                <section class="related-activities">
                    <h2>{{#str}}relatedactivities, format_streamdeck{{/str}}</h2>
                    <ul class="streamdeck-related-episodes">
                        {{#relatedactivities}}

                            {{! FORUM: modal preview }}
                            {{#isforum}}
                            <li class="streamdeck-related-episode">
                                <a href="{{url}}"
                                   class="streamdeck-related-episode-link js-streamdeck-forum-trigger"
                                   data-forum-cmid="{{cmid}}">
                                    <img src="{{icon}}" alt="" class="streamdeck-related-episode-icon">
                                    <div class="streamdeck-related-episode-main">
                                        <span class="streamdeck-related-episode-title">{{name}}</span>

                                        {{#completionenabled}}
                                        <span class="streamdeck-related-episode-status {{#iscomplete}}is-complete{{/iscomplete}}">
                                            {{#iscomplete}}
                                                {{#str}}completed, format_streamdeck{{/str}}
                                            {{/iscomplete}}
                                            {{^iscomplete}}
                                                {{#str}}todo, format_streamdeck{{/str}}
                                            {{/iscomplete}}
                                        </span>
                                        {{/completionenabled}}
                                    </div>
                                </a>

                                {{#forumpreviewhtml}}
                                <div class="d-none js-streamdeck-forum-content"
                                     data-forum-cmid="{{cmid}}">
                                    {{{forumpreviewhtml}}}
                                </div>
                                {{/forumpreviewhtml}}
                            </li>
                            {{/isforum}}

                            {{! ASSIGNMENT: modal preview, same pattern }}
                            {{#isassign}}
                            <li class="streamdeck-related-episode">
                                <a href="{{url}}"
                                   class="streamdeck-related-episode-link js-streamdeck-assign-trigger"
                                   data-assign-cmid="{{cmid}}">
                                    <img src="{{icon}}" alt="" class="streamdeck-related-episode-icon">
                                    <div class="streamdeck-related-episode-main">
                                        <span class="streamdeck-related-episode-title">{{name}}</span>

                                        {{#completionenabled}}
                                        <span class="streamdeck-related-episode-status {{#iscomplete}}is-complete{{/iscomplete}}">
                                            {{#iscomplete}}
                                                {{#str}}completed, format_streamdeck{{/str}}
                                            {{/iscomplete}}
                                            {{^iscomplete}}
                                                {{#str}}todo, format_streamdeck{{/str}}
                                            {{/iscomplete}}
                                        </span>
                                        {{/completionenabled}}
                                    </div>
                                </a>

                                {{#assignpreviewhtml}}
                                <div class="d-none js-streamdeck-assign-content"
                                     data-assign-cmid="{{cmid}}">
                                    {{{assignpreviewhtml}}}
                                </div>
                                {{/assignpreviewhtml}}
                            </li>
                            {{/isassign}}

                            {{! EVERYTHING ELSE: normal link }}
                            {{^isforum}}
                            {{^isassign}}
                            <li class="streamdeck-related-episode">
                                <a href="{{url}}" class="streamdeck-related-episode-link" target="_blank" rel="noopener">
                                    <img src="{{icon}}" alt="" class="streamdeck-related-episode-icon">
                                    <div class="streamdeck-related-episode-main">
                                        <span class="streamdeck-related-episode-title">{{name}}</span>
                                        {{#completionenabled}}
                                        <span class="streamdeck-related-episode-status {{#iscomplete}}is-complete{{/iscomplete}}">
                                            {{#iscomplete}}
                                                {{#str}}completed, format_streamdeck{{/str}}
                                            {{/iscomplete}}
                                            {{^iscomplete}}
                                                {{#str}}todo, format_streamdeck{{/str}}
                                            {{/iscomplete}}
                                        </span>
                                        {{/completionenabled}}
                                    </div>
                                </a>
                            </li>
                            {{/isassign}}
                            {{/isforum}}

                        {{/relatedactivities}}
                    </ul>
                </section>
                {{/relatedactivities.0}}
            </div>
            {{/hasrelatedsidebar}}

            {{#about}}
            <details class="streamdeck-about-card" open>
                <summary class="streamdeck-about-summary">
                    <h2>
                        {{#abouticon}}<i class="fa-solid fa-{{abouticon}} streamdeck-about-icon" aria-hidden="true"></i>{{/abouticon}}
                        {{abouttitle}}
                    </h2>
                    <i class="fa-solid fa-chevron-down streamdeck-about-chevron" aria-hidden="true"></i>
                </summary>
                <div class="streamdeck-about-body">{{{about}}}</div>
            </details>
            {{/about}}
        </aside>
        {{/hasleftcolumn}}
    </div>
</section>
{{/issectionview}}

    <!-- MAIN CONTENT -->
    {{! Hidden syllabus container used by JS for the More info modal }}
    {{#showallmodulesheader}}
        <section class="streamdeck-main-strip">
          <div class="container-fluid py-5 px-4">
            <h2 class="streamdeck-strip-title h3 fw-bold mb-4">{{#str}}allmodules, format_streamdeck{{/str}}</h2>
            {{^hasseasons}}
            <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 row-cols-xl-6 g-4" data-region="streamdeck-cards">
              {{#sections}}
              {{> format_streamdeck/card}}
              {{/sections}}
            </div>
            {{/hasseasons}}
            {{#hasseasons}}
            <div class="streamdeck-seasons" data-region="streamdeck-seasons">
              <div class="streamdeck-season-tabs" role="tablist" aria-orientation="horizontal" aria-label="{{seasonlabel}}">
                {{#seasons}}
                <button type="button" class="streamdeck-season-tab {{#selected}}is-active{{/selected}}" role="tab"
                        id="{{id}}-tab" aria-controls="{{id}}"
                        aria-selected="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}"
                        {{^selected}}tabindex="-1"{{/selected}}>
                  <span class="streamdeck-season-tab-kicker">{{kicker}}</span>
                  <span class="streamdeck-season-tab-name">{{name}}</span>
                  <span class="streamdeck-season-tab-count">{{episodecount}}</span>
                </button>
                {{/seasons}}
              </div>
              {{#seasons}}
              <section class="streamdeck-season-panel {{#selected}}is-active{{/selected}}" role="tabpanel"
                       id="{{id}}" aria-labelledby="{{id}}-tab">
                <h3 class="streamdeck-season-heading">
                  <span class="streamdeck-season-tab-kicker">{{kicker}}</span>
                  {{name}}
                  <span class="streamdeck-season-tab-count">{{episodecount}}</span>
                </h3>
                <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 row-cols-xl-6 g-4" data-region="streamdeck-cards">
                  {{#sections}}
                  {{> format_streamdeck/card}}
                  {{/sections}}
                </div>
              </section>
              {{/seasons}}
            </div>
            {{/hasseasons}}
          </div>
        </section>
    {{/showallmodulesheader}}
    
    
    <div id="streamdeck-syllabus"
         class="d-none"
         data-title="{{syllabustitle}}">

        <div class="streamdeck-syllabus-modal">
            <div class="streamdeck-syllabus-header">
                <div class="streamdeck-syllabus-title">
                    {{syllabustitle}}
                </div>
                {{#editsyllabusurl}}
                    <a href="{{.}}" class="streamdeck-syllabus-editbtn">
                        {{#str}}editsyllabus, format_streamdeck{{/str}}
                    </a>
                {{/editsyllabusurl}}
            </div>

            <div class="streamdeck-syllabus-pills" role="tablist" aria-orientation="horizontal">
                <button class="streamdeck-pill is-active" data-target="#sd-pill-intro" type="button" role="tab" id="sd-pill-intro-tab" aria-controls="sd-pill-intro" aria-selected="true">
                    {{#str}}syllabusintro, format_streamdeck{{/str}}
                </button>
                <button class="streamdeck-pill" data-target="#sd-pill-outcomes" type="button" role="tab" id="sd-pill-outcomes-tab" aria-controls="sd-pill-outcomes" aria-selected="false" tabindex="-1">
                    {{#str}}syllabusoutcomes, format_streamdeck{{/str}}
                </button>
                <button class="streamdeck-pill" data-target="#sd-pill-assessments" type="button" role="tab" id="sd-pill-assessments-tab" aria-controls="sd-pill-assessments" aria-selected="false" tabindex="-1">
                    {{#str}}syllabusassessments, format_streamdeck{{/str}}
                </button>
                <button class="streamdeck-pill" data-target="#sd-pill-materials" type="button" role="tab" id="sd-pill-materials-tab" aria-controls="sd-pill-materials" aria-selected="false" tabindex="-1">
                    {{#str}}syllabusmaterials, format_streamdeck{{/str}}
                </button>

                {{#hasschedule}}
                    <button class="streamdeck-pill" data-target="#sd-pill-schedule" type="button" role="tab" id="sd-pill-schedule-tab" aria-controls="sd-pill-schedule" aria-selected="false" tabindex="-1">
                        {{#str}}syllabusschedule, format_streamdeck{{/str}}
                    </button>
                {{/hasschedule}}
            </div>

            <div class="streamdeck-syllabus-panels">
                <div id="sd-pill-intro" class="streamdeck-syllabus-panel is-active" role="tabpanel" aria-labelledby="sd-pill-intro-tab">
                    {{{syllabus.introhtml}}}
                    {{^syllabus.introhtml}}
                        {{{summary}}}
                    {{/syllabus.introhtml}}
                </div>
                <div id="sd-pill-outcomes" class="streamdeck-syllabus-panel" role="tabpanel" aria-labelledby="sd-pill-outcomes-tab">
                    {{{syllabus.outcomeshtml}}}
                </div>
                <div id="sd-pill-assessments" class="streamdeck-syllabus-panel" role="tabpanel" aria-labelledby="sd-pill-assessments-tab">
                    {{{syllabus.assessmentshtml}}}
                </div>
                <div id="sd-pill-materials" class="streamdeck-syllabus-panel" role="tabpanel" aria-labelledby="sd-pill-materials-tab">
                    {{{syllabus.materialshtml}}}
                </div>
                {{#hasschedule}}
                    <div id="sd-pill-schedule" class="streamdeck-syllabus-panel" role="tabpanel" aria-labelledby="sd-pill-schedule-tab">
                        {{{schedulehtml}}}
                    </div>
                {{/hasschedule}}
            </div>
        </div>
    </div>
</div>