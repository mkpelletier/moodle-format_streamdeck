{{!
    @template format_streamdeck/local/discussion_list

    The discussions in a forum (an episode's, or the course's discussion forum in the hero). Choosing one opens its
    thread in the same panel; starting one opens mod_forum's form in the composer (amd/src/main.js).

    Context variables required for this template:
    * forumname - string
    * forumurl - string - The forum page
    * discussions - array - id, name, replies, lastactivity, pinned
    * hasdiscussions - bool
    * canstart - bool - Whether the learner can start a discussion
    * starturl - string - The form to start one

    Example context (json):
    {
        "forumname": "Lecture questions", "forumurl": "#", "hasdiscussions": true, "canstart": true, "starturl": "#",
        "discussions": [{"id": 3, "name": "What is a noun?", "replies": "2 replies", "lastactivity": "1 hour ago",
            "pinned": false}]
    }
}}
<div class="sd-thread" data-region="sd-discussion-list">
    <header class="sd-thread-header">
        <div class="sd-thread-heading">
            <span class="sd-thread-kicker">{{#str}}discussions, format_streamdeck{{/str}}</span>
            <h3 class="sd-thread-title">{{forumname}}</h3>
        </div>
        <a class="sd-icon-btn sd-thread-open" href="{{forumurl}}"
           aria-label="{{#str}}openfulldiscussion, format_streamdeck{{/str}}"
           title="{{#str}}openfulldiscussion, format_streamdeck{{/str}}">
            <i class="fa-solid fa-up-right-from-square" aria-hidden="true"></i>
        </a>
    </header>
    {{#canstart}}
        <div class="sd-reply-bar" data-region="sd-composer-slot">
            <button type="button" class="sd-reply-bar-button" data-action="sd-compose" data-url="{{starturl}}">
                <i class="fa-solid fa-plus" aria-hidden="true"></i> {{#str}}startdiscussion, format_streamdeck{{/str}}
            </button>
        </div>
    {{/canstart}}
    {{^hasdiscussions}}
        <p class="sd-discussion-empty">{{#str}}nodiscussions, format_streamdeck{{/str}}</p>
    {{/hasdiscussions}}
    {{#hasdiscussions}}
    <ul class="sd-discussion-list">
        {{#discussions}}
            <li>
                <button type="button" class="sd-discussion-item" data-action="sd-discussion-open" data-discussionid="{{id}}">
                    <span class="sd-discussion-name">
                        {{#pinned}}<i class="fa-solid fa-thumbtack" aria-hidden="true"></i>{{/pinned}}
                        {{name}}
                    </span>
                    <span class="sd-discussion-meta">{{replies}} · {{lastactivity}}</span>
                </button>
            </li>
        {{/discussions}}
    </ul>
    {{/hasdiscussions}}
</div>
